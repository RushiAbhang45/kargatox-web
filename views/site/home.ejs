<!doctype html>
<html lang="en" class="h-full antialiased">
<head>
<%- include('../partials/doc-head', { title: "Kargatox — Strategy, Research & Growth Marketing", description: "Kargatox helps founders and leadership teams understand their market, decode their customers, and turn that insight into campaigns that move revenue — across India." }) %>
</head>
<body class="min-h-full flex flex-col bg-paper text-ink font-body">
<%- include('../partials/site-header', { activePath: '/' }) %>
<%
// Ported from legacy-nextjs-app/src/app/(site)/page.tsx. `content` (PAGE_DEFAULTS.home
// for now — Phase 2 swaps in the real DB-backed merge), `capabilitiesPlain` /
// `capabilitiesAccent` (via lib/text-split.js's splitFirstSentence) come from
// routes/site.js. PILLARS/CAPABILITY_SERVICES/TICKER are page-local static content,
// never DB-editable (see lib/page-content-defaults.js's PAGE_FIELDS), so they're
// inlined here exactly as the original page.tsx had them in module scope.
const PILLARS = [
  { num: "01", title: "Founder-Led", body: "Started and run by people who've built businesses themselves — not advisors reciting a framework." },
  { num: "02", title: "In The Weeds", body: "We sit inside your CRM, your campaigns and your calls. The work happens with your team, not around it." },
  { num: "03", title: "Numbers First", body: "Every engagement is scoped against a number that needs to move: pipeline, retention, revenue. Not a deck." },
];
const CAPABILITY_SERVICES = [
  { num: "01", title: "Research Services", subs: ["Market Research", "Consumer Behaviour & Satisfaction Analysis", "Campaign Analytics"] },
  { num: "02", title: "Marketing Services", subs: ["SEO Services", "Social Media Marketing", "Brand Campaigns Strategy"] },
];
const TICKER = [...CAPABILITY_SERVICES.flatMap((s) => s.subs), ...CAPABILITY_SERVICES.flatMap((s) => s.subs)];
const heroWords = content.heroHeadline.split(" ");
// PROCESS_STEPS comes from app.locals (server.js) — see site-header.ejs for why.
%>
<main class="flex flex-1 flex-col">
  <section class="relative overflow-hidden bg-white text-ink">
    <div aria-hidden="true" class="pointer-events-none absolute opacity-[0.16] inset-x-0 top-0 h-[520px]" style="background-image: repeating-linear-gradient(90deg, transparent 0 110px, rgba(15,23,42,1) 110px 111px), repeating-linear-gradient(0deg, transparent 0 110px, rgba(15,23,42,1) 110px 111px); mask-image: radial-gradient(circle at 20% 30%, black 0%, transparent 70%);"></div>
    <div class="relative mx-auto max-w-(--width-site) px-6 pb-[48px] pt-[56px]">
      <div class="inline-flex items-center gap-2.5 rounded-chip border border-line px-3.5 py-[7px] font-mono text-xs uppercase tracking-[0.08em] text-slate">
        <span class="h-[7px] w-[7px] rounded-full bg-orange-500"></span>
        <span data-scramble-reveal="Strategy · Research · Growth">Strategy · Research · Growth</span>
      </div>
      <h1 class="mt-6 max-w-[760px] font-display text-[clamp(30px,4.6vw,56px)] font-bold leading-[1.04] tracking-[-0.025em]">
        <% heroWords.forEach(function(w, i) { %><% if (i === heroWords.length - 1) { %><span class="text-orange-500"><%= w %></span><% } else { %><%= w %> <% } %><% }) %>
      </h1>
      <div class="mt-7 flex flex-col gap-6 border-t border-line pt-6 lg:flex-row lg:items-end lg:justify-between">
        <p class="max-w-[480px] text-[clamp(15px,1.3vw,17px)] leading-[1.6] text-slate"><%= content.heroSubheading %></p>
        <div class="flex flex-none flex-wrap gap-3">
          <a href="/contact" class="rounded-pill bg-orange-500 px-6 py-3 text-[15px] font-semibold text-white transition-colors hover:bg-orange-400">Start an Inquiry →</a>
          <a href="/services" class="rounded-input border border-line px-6 py-3 text-[15px] font-semibold text-ink transition-colors hover:border-orange-500">Explore services</a>
        </div>
      </div>
    </div>
  </section>

  <div class="overflow-hidden border-t border-b border-white/8 bg-ink py-[14px]">
    <div class="kx-marquee-track flex w-max">
      <% [...TICKER, ...TICKER].forEach(function(label, i) { %>
        <span class="flex items-center gap-4 whitespace-nowrap pr-4 font-display text-[clamp(13px,1.2vw,16px)] font-semibold tracking-[-0.01em] text-white">
          <span class="h-1.5 w-1.5 rounded-[2px] <%= i % 2 ? 'bg-white' : 'bg-orange-500' %>"></span>
          <%= label %>
        </span>
      <% }) %>
    </div>
  </div>

  <section class="relative overflow-hidden bg-white px-6 py-[64px]">
    <div aria-hidden="true" class="pointer-events-none absolute -left-[10%] top-0 h-full w-[60%] opacity-[0.16]" style="background-image: repeating-linear-gradient(90deg, transparent 0 110px, rgba(15,23,42,1) 110px 111px), repeating-linear-gradient(0deg, transparent 0 110px, rgba(15,23,42,1) 110px 111px); mask-image: radial-gradient(circle at 20% 30%, black 0%, transparent 70%);"></div>
    <span aria-hidden="true" class="pointer-events-none absolute -bottom-[6%] -right-[2%] select-none whitespace-nowrap font-display text-[16vw] font-bold leading-none text-ink/[0.035]">Kargatox</span>
    <div class="relative mx-auto max-w-(--width-site)">
      <%- include('../partials/section-intro', { eyebrow: 'WHAT DEFINES US', titleHtml: 'Founder-led, numbers-obsessed, and in the weeds with your team.' }) %>
      <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-3">
        <% PILLARS.forEach(function(p) { %>
          <div class="border-t border-line pt-4">
            <div class="font-display text-[13px] font-bold text-orange-500"><%= p.num %></div>
            <h3 class="mt-2 font-display text-[18px] font-bold tracking-[-0.01em]"><%= p.title %></h3>
            <p class="mt-2 text-[14px] leading-[1.6] text-slate"><%= p.body %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="px-6 pt-[48px] pb-[48px]">
    <div class="mx-auto grid max-w-(--width-site) grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] items-end gap-x-16 gap-y-8">
      <div>
        <div class="font-mono text-[12px] tracking-[0.12em] text-orange-500" data-scramble-reveal="OUR CAPABILITIES">OUR CAPABILITIES</div>
        <h2 class="mt-2.5 font-display text-[clamp(26px,3.2vw,40px)] font-bold leading-[1.08] tracking-[-0.022em]">
          <%= capabilitiesPlain %><% if (capabilitiesAccent) { %><span class="text-orange-500"> <%= capabilitiesAccent %></span><% } %>
        </h2>
      </div>
      <p class="text-[16px] leading-[1.6] text-slate"><%= content.capabilitiesBody %></p>
    </div>
  </section>

  <section class="px-6 py-[56px]">
    <div class="mx-auto grid max-w-(--width-site) grid-cols-1 overflow-hidden rounded-card border border-line bg-paper sm:grid-cols-2">
      <% CAPABILITY_SERVICES.forEach(function(s, i) { %>
        <a href="/services" class="group relative flex flex-col justify-center gap-4 overflow-hidden bg-white p-6 text-ink transition-colors hover:bg-paper sm:p-10 <%= i === 0 ? 'border-b border-line sm:border-b-0 sm:border-r' : '' %>">
          <span aria-hidden="true" class="pointer-events-none absolute -right-[2%] top-1/2 -translate-y-1/2 select-none whitespace-nowrap font-display text-[clamp(56px,10vw,110px)] font-bold leading-none text-ink/[0.04]"><%= s.title.split(" ")[0] %></span>
          <div class="relative font-mono text-[13px] text-orange-500"><%= s.num %></div>
          <h3 class="relative max-w-[460px] font-display text-[clamp(24px,3.2vw,38px)] font-bold leading-[1.05] tracking-[-0.02em]"><%= s.title %></h3>
          <div class="relative flex flex-wrap gap-2">
            <% s.subs.forEach(function(sub) { %>
              <span class="rounded-chip bg-chip-cool px-3.5 py-2 text-[13px] font-medium text-[#262626]"><%= sub %></span>
            <% }) %>
          </div>
          <span class="relative mt-1 inline-flex items-center gap-1 text-[15px] font-semibold text-orange-500 transition-transform duration-300 group-hover:translate-x-1">View details →</span>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="px-6 py-[48px]">
    <div class="mx-auto max-w-(--width-site) rounded-panel border border-line bg-paper p-8 text-center text-slate">
      <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-orange-500">Revenue check</p>
      <p class="mt-2 text-[15px]">The interactive revenue-check quiz is being ported in a later phase — not yet live on this build.</p>
    </div>
  </section>

  <section class="relative overflow-hidden bg-ink px-6 py-[64px] text-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-[15%] top-0 h-full w-[60%] opacity-[0.16]" style="background-image: repeating-linear-gradient(90deg, transparent 0 110px, rgba(255,255,255,1) 110px 111px), repeating-linear-gradient(0deg, transparent 0 110px, rgba(255,255,255,1) 110px 111px); mask-image: radial-gradient(circle at 20% 30%, black 0%, transparent 70%);"></div>
    <div class="relative mx-auto max-w-(--width-site)">
      <%- include('../partials/section-intro', {
        eyebrow: 'HOW WE WORK',
        dark: true,
        titleHtml: 'We do the work.<br/><span class="text-white/60">You keep the system.</span>',
        ctaHtml: '<a href="/how-we-work" class="whitespace-nowrap rounded-input border border-white/25 px-5 py-2.5 text-[14px] font-semibold text-white transition-colors hover:border-orange-400">See the full process →</a>'
      }) %>
      <div class="mt-9 grid grid-cols-1 gap-x-8 gap-y-7 sm:grid-cols-3">
        <% PROCESS_STEPS.slice(0, 3).forEach(function(s) { %>
          <div class="border-t border-white/12 pt-4">
            <div class="flex items-baseline justify-between gap-3">
              <div class="font-display text-[13px] font-bold text-orange-400"><%= s.num %></div>
              <span class="rounded-chip bg-white/8 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.06em] text-mist-2"><%= s.when %></span>
            </div>
            <h3 class="mt-2 font-display text-[16px] font-bold tracking-[-0.01em] text-white"><%= s.title %></h3>
            <p class="mt-1.5 text-[13px] leading-[1.6] text-mist-2"><%= s.body %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden px-6 pt-[48px] pb-[64px]">
    <div aria-hidden="true" class="pointer-events-none absolute -right-[10%] top-0 h-full w-[55%] opacity-[0.16]" style="background-image: repeating-linear-gradient(90deg, transparent 0 110px, rgba(15,23,42,1) 110px 111px), repeating-linear-gradient(0deg, transparent 0 110px, rgba(15,23,42,1) 110px 111px); mask-image: radial-gradient(circle at 20% 30%, black 0%, transparent 70%);"></div>
    <div class="relative mx-auto max-w-(--width-site)">
      <%- include('../partials/section-intro', {
        eyebrow: 'BEFORE YOU ASK',
        arrow: 'right',
        titleHtml: 'You have questions. <span class="text-orange-500">We have straight answers.</span>',
        ctaHtml: '<a href="/faq" class="whitespace-nowrap rounded-pill bg-ink px-5 py-2.5 text-[14px] font-semibold text-white transition-colors hover:bg-orange-500">Read the FAQ →</a>'
      }) %>
    </div>
  </section>
</main>
<%- include('../partials/site-footer', { showCta: true }) %>
</body>
</html>
