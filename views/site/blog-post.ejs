<!doctype html>
<html lang="en" class="h-full antialiased">
<head>
<%- include('../partials/doc-head', { meta: { title: "Post not available yet — Kargatox", description: "Insights, case studies, and updates from the Kargatox team.", path: "/blog/" + slug, robots: "noindex, follow" } }) %>
</head>
<body class="min-h-full flex flex-col bg-paper text-ink font-body">
<%- include('../partials/site-header', { activePath: '/blog' }) %>
<main class="flex flex-1 flex-col px-6 py-[64px]">
  <div class="mx-auto max-w-(--width-site) text-center">
    <h1 class="font-display text-[clamp(26px,3.4vw,42px)] font-bold tracking-[-0.02em]">Post not available yet</h1>
    <p class="mt-4 text-[15px] leading-[1.6] text-slate">
      Individual blog posts (slug: <%= slug %>) render once the Post model and Tiptap
      renderer are ported — see Phase 8 of the rewrite plan.
    </p>
    <a href="/blog" class="mt-6 inline-block rounded-pill bg-ink px-5 py-2.5 text-[14px] font-semibold text-white transition-colors hover:bg-orange-500">← Back to Blog</a>
  </div>
</main>
<%- include('../partials/site-footer', { showCta: true }) %>
</body>
</html>
