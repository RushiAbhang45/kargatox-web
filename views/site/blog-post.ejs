<!doctype html>
<html lang="en" class="h-full antialiased">
<head>
<%- include('../partials/doc-head', { meta: meta }) %>
</head>
<body class="min-h-full flex flex-col bg-paper text-ink font-body">
<%- include('../partials/site-header', { activePath: '/blog' }) %>
<%
// Ported from legacy-nextjs-app/src/app/(site)/blog/[slug]/page.tsx (Phase 8). `post` comes
// from routes/site.js — a published Post row. `post.body` is plain HTML (not legacy's Tiptap
// JSON, see lib/post-schema.js's header comment), rendered unescaped below on purpose.
%>
<main class="flex flex-1 flex-col px-6 py-[56px]">
  <article class="mx-auto max-w-[720px]">
    <a href="/blog" class="text-[13px] font-semibold text-orange-500 hover:text-ink">← All posts</a>

    <span class="mt-5 block w-fit rounded-chip bg-chip-cool px-2.5 py-1 text-[11px] font-semibold tracking-[0.04em] text-[#262626]"><%= post.type === "CASE_STUDY" ? "Case study" : "Blog" %></span>
    <h1 class="mt-3 font-display text-[clamp(26px,3.6vw,44px)] font-bold leading-[1.1] tracking-[-0.02em]"><%= post.title %></h1>
    <p class="mt-3 text-[13px] text-slate">
      <%= (post.author && post.author.name) || "Kargatox" %>
      <% if (post.publishedAt) { %> · <%= new Date(post.publishedAt).toLocaleDateString(undefined, { day: "numeric", month: "short", year: "numeric" }) %><% } %>
    </p>

    <div class="kx-prose mt-8 text-[16px] leading-[1.7] text-ink"><%- post.body %></div>
  </article>
</main>
<%- include('../partials/site-footer', { showCta: true }) %>
</body>
</html>
