<!doctype html>
<html lang="en" class="h-full antialiased">
<head>
<%- include('../partials/doc-head', { meta: meta }) %>
</head>
<body class="min-h-full flex flex-col bg-paper text-ink font-body">
<%- include('../partials/site-header', { activePath: '/how-we-work' }) %>
<%
// Ported from legacy-nextjs-app/src/app/(site)/how-we-work/page.tsx. `content`
// (PAGE_DEFAULTS["how-we-work"] for now) comes from routes/site.js — admin-editable as
// "first line\nsecond line", falls back to a single line if no newline.
// PROCESS_STEPS comes from app.locals (server.js) — see site-header.ejs for why.
const headlineParts = content.headline.split("\n");
const headlineLine1 = headlineParts[0];
const headlineLine2 = headlineParts[1];
%>
<main class="flex flex-1 flex-col">
  <section class="bg-white text-ink">
    <div class="mx-auto grid max-w-(--width-site) grid-cols-[repeat(auto-fit,minmax(min(100%,360px),1fr))] items-end gap-x-14 gap-y-6 px-6 pb-[48px] pt-[56px]">
      <div>
        <div class="font-mono text-[12px] tracking-[0.12em] text-orange-500" data-scramble-reveal="HOW WE WORK">HOW WE WORK</div>
        <h1 class="mt-3 font-display text-[clamp(26px,3.4vw,42px)] font-bold leading-[1.08] tracking-[-0.02em]">
          <%= headlineLine1 %><% if (headlineLine2) { %><br/><span class="text-slate"><%= headlineLine2 %></span><% } %>
        </h1>
      </div>
      <div>
        <p class="text-[15px] leading-[1.6] text-slate"><%= content.subline %></p>
        <p class="mt-3 rounded-input border border-orange-400/35 bg-orange-500/8 px-4 py-3 text-[14px] leading-[1.6] text-ink">
          <strong class="text-orange-500">Straight up:</strong> <%= content.straightUpNote %>
        </p>
      </div>
    </div>
  </section>

  <section class="px-6 pb-[64px] pt-[40px]">
    <%- include('../partials/numbered-rows', {
      className: 'mx-auto grid max-w-[820px]',
      variant: 'full',
      theme: 'light',
      items: PROCESS_STEPS.map(function(s) { return Object.assign({}, s, { meta: s.when }); })
    }) %>
  </section>
</main>
<%- include('../partials/site-footer', { showCta: true }) %>
</body>
</html>
