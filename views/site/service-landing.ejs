<!doctype html>
<html lang="en" class="h-full antialiased">
<head>
<%- include('../partials/doc-head', { meta: meta }) %>
</head>
<body class="min-h-full flex flex-col bg-paper text-ink font-body">
<%- include('../partials/site-header', { activePath: '/' + content.slug }) %>
<%
// Ported from legacy-nextjs-app/src/components/services/service-landing-page.tsx. One
// shared template for all 6 service pages — `content` and `related` come from
// routes/site.js's single GET route matching the 6 known slugs.
%>
<main class="flex flex-1 flex-col">
  <section class="bg-white text-ink">
    <div class="mx-auto grid max-w-(--width-site) gap-5 px-6 pb-[48px] pt-[56px]">
      <div class="font-mono text-[12px] tracking-[0.12em] text-orange-500" data-scramble-reveal="<%= content.eyebrow %>"><%= content.eyebrow %></div>
      <h1 class="max-w-[760px] font-display text-[clamp(26px,3.4vw,42px)] font-bold leading-[1.1] tracking-[-0.022em]"><%= content.h1 %></h1>
      <p class="max-w-[760px] text-[15px] leading-[1.7] text-slate"><%= content.intro %></p>
      <div class="mt-1 flex flex-wrap gap-3">
        <a href="/contact" class="rounded-pill bg-ink px-6 py-3 text-[14px] font-semibold text-white transition-colors hover:bg-orange-500">Start an Inquiry →</a>
        <a href="/services" class="rounded-pill border border-line px-6 py-3 text-[14px] font-semibold text-ink transition-colors hover:border-orange-500">← Back to Services</a>
      </div>
    </div>
  </section>

  <section class="px-6 pb-[16px] pt-[8px]">
    <div class="mx-auto max-w-(--width-site)">
      <h2 class="font-display text-[clamp(22px,2.6vw,30px)] font-bold tracking-[-0.02em]"><%= content.coverHeading %></h2>
      <%- include('../partials/numbered-rows', {
        className: 'mt-6 max-w-[820px]',
        variant: 'full',
        theme: 'light',
        items: content.coverItems.map(function(it, i) { return { num: String(i + 1).padStart(2, "0"), title: it.title, body: it.body }; })
      }) %>
    </div>
  </section>

  <section class="px-6 py-[48px]">
    <div class="mx-auto grid max-w-(--width-site) gap-10 rounded-panel bg-ink p-[clamp(28px,5vw,56px)] text-white md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        <h2 class="font-display text-[clamp(20px,2.4vw,28px)] font-bold tracking-[-0.02em]"><%= content.approachHeading %></h2>
        <p class="mt-3 text-[15px] leading-[1.7] text-mist-2"><%= content.approachBody %></p>
      </div>
      <% if (content.steps) { %>
        <div>
          <% if (content.steps.heading) { %>
            <div class="font-mono text-[12px] uppercase tracking-[0.12em] text-orange-400"><%= content.steps.heading %></div>
          <% } %>
          <%- include('../partials/numbered-rows', {
            className: content.steps.heading ? 'mt-4' : undefined,
            variant: 'tight',
            theme: 'dark',
            items: content.steps.items.map(function(s, i) { return { num: String(i + 1).padStart(2, "0"), title: s.label, body: s.body }; })
          }) %>
        </div>
      <% } %>
    </div>
  </section>

  <% if (content.bulletLists.length > 0) { %>
    <section class="px-6 pb-[16px]">
      <div class="mx-auto grid max-w-(--width-site) grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-10">
        <% content.bulletLists.forEach(function(list) { %>
          <%- include('../partials/bullet-list', { heading: list.heading, items: list.items }) %>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="px-6 py-[56px]">
    <div class="mx-auto max-w-[820px]">
      <h2 class="font-display text-[clamp(22px,2.6vw,30px)] font-bold tracking-[-0.02em]"><%= content.faqHeading %></h2>
      <div class="mt-6">
        <%- include('../partials/faq-accordion', { items: content.faqs.map(function(f, i) { return Object.assign({ id: content.slug + "-faq-" + i }, f); }) }) %>
      </div>
    </div>
  </section>

  <% if (related.length > 0) { %>
    <section class="px-6 pb-[32px]">
      <div class="mx-auto flex max-w-(--width-site) flex-wrap items-center gap-3 border-t border-line-2 pt-8 text-[14px]">
        <span class="font-mono text-[12px] uppercase tracking-[0.1em] text-slate">Related services</span>
        <% related.forEach(function(r) { %>
          <a href="/<%= r.slug %>" class="rounded-chip border border-line px-3.5 py-1.5 font-semibold text-ink transition-colors hover:border-orange-500 hover:text-orange-500"><%= r.title %></a>
        <% }) %>
      </div>
    </section>
  <% } %>
</main>
<%- include('../partials/site-footer', { showCta: true }) %>
</body>
</html>
