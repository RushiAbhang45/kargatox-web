<!doctype html>
<html lang="en" class="h-full antialiased">
<head>
<%- include('../partials/doc-head', { meta: meta }) %>
</head>
<body class="min-h-full flex flex-col bg-paper text-ink font-body">
<%- include('../partials/site-header', { activePath: '/services' }) %>
<%
// Ported from legacy-nextjs-app/src/app/(site)/services/page.tsx. `content`
// (PAGE_DEFAULTS.services for now) comes from routes/site.js; SERVICES/SUB_SERVICE_HREFS
// are required directly, matching the pattern used in the shared partials.
// SERVICES/SUB_SERVICE_HREFS come from app.locals (server.js) — see site-header.ejs.
%>
<main class="flex flex-1 flex-col">
  <section class="bg-white text-ink">
    <div class="relative mx-auto grid max-w-(--width-site) gap-5 px-6 pb-[48px] pt-[56px]">
      <div class="font-mono text-[12px] tracking-[0.12em] text-orange-500" data-scramble-reveal="SERVICES">SERVICES</div>
      <h1 class="max-w-[720px] font-display text-[clamp(26px,3.4vw,42px)] font-bold leading-[1.1] tracking-[-0.022em]"><%= content.introHeadline %></h1>
      <div class="mt-2 grid grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] gap-x-12 gap-y-4 text-[15px] leading-[1.6] text-slate">
        <p><%= content.introParagraph1 %></p>
        <p><%= content.introParagraph2 %></p>
      </div>
      <div class="mt-2 flex flex-wrap gap-2.5">
        <a href="#research" class="rounded-input border border-line px-4 py-2.5 text-[14px] font-semibold text-ink transition-colors hover:border-orange-500">Research Services ↓</a>
        <a href="#marketing" class="rounded-input border border-line px-4 py-2.5 text-[14px] font-semibold text-ink transition-colors hover:border-orange-500">Marketing Services ↓</a>
      </div>
    </div>
  </section>

  <% SERVICES.forEach(function(svc, i) { %>
    <section id="<%= svc.id %>" class="px-6 <%= i === 0 ? 'pt-[40px]' : 'pt-[64px]' %>">
      <div class="mx-auto grid max-w-(--width-site) grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] items-start gap-x-12 gap-y-8">
        <div class="sticky top-[88px]">
          <div class="font-mono text-[12px] tracking-[0.12em] text-orange-500"><%= svc.num %></div>
          <h2 class="mt-2.5 font-display text-[clamp(24px,3vw,36px)] font-bold leading-[1.08] tracking-[-0.02em]"><%= svc.title %></h2>
          <p class="mt-3 text-[15px] leading-[1.6] text-slate"><%= svc.intro %></p>
          <% if (svc.tagline) { %>
            <p class="mt-4 font-display text-lg font-bold tracking-[-0.01em] text-orange-500"><%= svc.tagline %></p>
          <% } %>

          <div class="mt-6 grid gap-4 rounded-panel bg-ink p-5 text-white shadow-[0_20px_40px_-24px_rgba(15,23,42,0.5)]">
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-success-dark"></span>
                <span class="font-display text-[15px] font-bold"><%= svc.panelTitle %></span>
              </div>
              <span class="rounded-chip border border-white/18 px-2 py-1 font-mono text-[10px] tracking-[0.08em] text-mist-2">SAMPLE DATA</span>
            </div>

            <% if (svc.kind === "research") { %>
              <div class="grid gap-2">
                <div class="flex h-[90px] items-end gap-1">
                  <% svc.bars.forEach(function(b) { %>
                    <div class="flex-1 rounded-t-[4px] rounded-b-[2px] <%= b.orange ? 'bg-orange-500' : 'bg-white/25' %>" style="height: <%= b.h %>%;"></div>
                  <% }) %>
                </div>
                <div class="flex justify-between font-mono text-[10px] text-[#737373]">
                  <span>JAN</span><span>JUN</span><span>DEC</span>
                </div>
              </div>
            <% } %>

            <% if (svc.kind === "marketing") { %>
              <div class="grid gap-1.5">
                <% svc.keywords.forEach(function(k) { %>
                  <div class="grid grid-cols-[minmax(0,1fr)_auto_auto] items-center gap-2.5 rounded-lg bg-white/5 px-3 py-2">
                    <span class="overflow-hidden text-ellipsis whitespace-nowrap text-[13px] text-[#e5e5e5]"><%= k.term %></span>
                    <span class="font-mono text-[11px] text-[#737373] line-through">#<%= k.from %></span>
                    <span class="rounded-chip bg-success-dark/12 px-2 py-0.5 font-mono text-[11px] text-success-dark">↑ #<%= k.to %></span>
                  </div>
                <% }) %>
              </div>
              <div class="mt-1 grid gap-2">
                <% svc.channels.forEach(function(c) { %>
                  <div class="grid grid-cols-[76px_minmax(0,1fr)_36px] items-center gap-2.5">
                    <span class="text-[12px] text-mist-2"><%= c.name %></span>
                    <div class="h-1.5 overflow-hidden rounded-lg bg-white/8">
                      <div class="h-full rounded-lg <%= c.orange ? 'bg-orange-500' : 'bg-white/35' %>" style="width: <%= c.w %>%;"></div>
                    </div>
                    <span class="text-right font-mono text-[11px] text-white"><%= c.w %>%</span>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <div class="grid grid-cols-3 gap-1.5">
              <% svc.kpis.forEach(function(kp) { %>
                <div class="grid gap-1 rounded-lg bg-white/5 p-2.5">
                  <span class="text-[11px] text-mist-2"><%= kp.label %></span>
                  <span class="font-display text-lg font-bold"><%= kp.value %></span>
                  <span class="font-mono text-[10px] text-success-dark"><%= kp.delta %></span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="grid gap-3">
          <% svc.items.forEach(function(it) { %>
            <% const href = SUB_SERVICE_HREFS[it.title]; %>
            <div class="rounded-card border border-line bg-white p-5 transition-[transform,border-color] duration-500 ease-[var(--ease-kx)] hover:translate-x-1 hover:border-orange-500">
              <div class="flex gap-3">
                <span class="font-mono text-[12px] text-orange-500"><%= it.num %></span>
                <div class="flex-1">
                  <h3 class="font-display text-[17px] font-bold tracking-[-0.01em]"><%= it.title %></h3>
                  <p class="mt-2 text-[14px] leading-[1.6] text-slate"><%= it.body %></p>
                  <% if (href) { %>
                    <a href="<%= href %>" class="mt-2.5 inline-block text-[14px] font-semibold text-orange-500 hover:text-ink"><%= it.link || "Learn more" %> →</a>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% }) %>

  <div class="h-[64px]"></div>
</main>
<%- include('../partials/site-footer', { showCta: true }) %>
</body>
</html>
