<!doctype html>
<html lang="en" class="h-full antialiased">
<head>
<%- include('../partials/doc-head', { meta: meta }) %>
</head>
<body class="min-h-full flex flex-col bg-paper text-ink font-body">
<%- include('../partials/site-header', { activePath: '/blog' }) %>
<%
// Ported from legacy-nextjs-app/src/app/(site)/blog/page.tsx (Phase 8). `posts` comes from
// routes/site.js — published Post rows (type BLOG or CASE_STUDY), newest first.
%>
<main class="flex flex-1 flex-col px-6 py-[56px]">
  <div class="mx-auto max-w-(--width-site)">
    <div class="max-w-[640px]">
      <div class="font-mono text-[12px] tracking-[0.12em] text-orange-500" data-scramble-reveal="INSIGHTS">INSIGHTS</div>
      <h1 class="mt-2.5 font-display text-[clamp(26px,3.4vw,42px)] font-bold leading-[1.08] tracking-[-0.02em]">Insights from the work.</h1>
      <p class="mt-3 text-[15px] leading-[1.6] text-slate">Research notes, case studies and updates from the Kargatox team.</p>
    </div>

    <% if (posts.length === 0) { %>
      <p class="mt-10 rounded-card border border-line bg-white px-6 py-10 text-center text-[14px] text-slate">No posts published yet — check back soon.</p>
    <% } else { %>
      <div class="mt-10 grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-6">
        <% posts.forEach(function(post) { %>
          <a href="/blog/<%= post.slug %>" class="group flex flex-col gap-3 rounded-card border border-line bg-white p-6 transition-colors hover:border-orange-500">
            <span class="w-fit rounded-chip bg-chip-cool px-2.5 py-1 text-[11px] font-semibold tracking-[0.04em] text-[#262626]"><%= post.type === "CASE_STUDY" ? "Case study" : "Blog" %></span>
            <h2 class="font-display text-[19px] font-bold leading-[1.2] tracking-[-0.01em] text-ink transition-colors group-hover:text-orange-500"><%= post.title %></h2>
            <% if (post.excerpt) { %><p class="text-[14px] leading-[1.6] text-slate"><%= post.excerpt %></p><% } %>
            <p class="mt-auto pt-2 text-[12px] text-slate">
              <%= (post.author && post.author.name) || "Kargatox" %>
              <% if (post.publishedAt) { %> · <%= new Date(post.publishedAt).toLocaleDateString(undefined, { day: "numeric", month: "short", year: "numeric" }) %><% } %>
            </p>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>
<%- include('../partials/site-footer', { showCta: true }) %>
</body>
</html>
