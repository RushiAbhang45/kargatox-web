<%
// Home page revenue-check quiz — ported from legacy-nextjs-app/src/components/home/
// revenue-check.tsx (replaces the "being ported in a later phase" placeholder, client
// change list 2026-11-02). Server renders the shell + the first question; behaviour
// (answer/back/result/retake, meters, POST /api/revenue-checks) is public/js/revenue-check.js,
// which reads QUESTIONS/RESULTS from the JSON block below so copy lives only in
// lib/revenue-check-data.js. Props: `rc` = { QUESTIONS, RESULTS, ALL_HEALTHY_TITLE, NOTE_PREFIX }.
const first = rc.QUESTIONS[0];
%>
<section id="revenue-check" class="px-6 py-[48px]" data-revenue-check>
  <script type="application/json" data-revenue-check-data><%- JSON.stringify(rc).replace(/</g, "\\u003c") %></script>
  <div class="mx-auto grid max-w-(--width-site) grid-cols-1 overflow-hidden rounded-panel border border-line bg-white min-[880px]:grid-cols-2">
    <div class="grid content-start gap-[22px] p-[clamp(28px,5vw,56px)]">
      <span class="font-mono text-[13px] tracking-[0.12em] text-blue-600">REVENUE CHECK · 30 SECONDS</span>
      <h2 class="font-display text-[clamp(30px,3.6vw,48px)] font-bold leading-[1.04] tracking-[-0.02em]">Where is your revenue <span class="text-blue-600">leaking?</span></h2>
      <p class="text-[17px] leading-[1.6] text-slate">Answer three questions. We'll show you which area to fix first.</p>
      <div class="mt-3" data-rc-stage aria-live="polite">
        <div class="grid gap-[18px]">
          <div class="flex items-center gap-3.5">
            <div class="flex flex-1 gap-1.5">
              <div class="h-1 flex-1 rounded-full bg-ink"></div>
              <div class="h-1 flex-1 rounded-full bg-chip-neutral"></div>
              <div class="h-1 flex-1 rounded-full bg-chip-neutral"></div>
            </div>
            <span class="whitespace-nowrap font-mono text-xs text-[#737373]">1 / 3</span>
          </div>
          <span class="w-fit rounded-chip bg-[#e8f0ff] px-3 py-1.5 font-mono text-xs uppercase tracking-[0.08em] text-blue-600"><%= first.area %></span>
          <h3 class="font-display text-[clamp(22px,2.4vw,28px)] font-bold tracking-[-0.01em]"><%= first.text %></h3>
          <div class="grid gap-2.5">
            <% first.options.forEach(function(o) { %>
              <button type="button" data-rc-answer="<%= o[1] %>" class="flex items-center justify-between gap-4 rounded-[14px] border-[1.5px] border-line bg-white px-5 py-[18px] text-left text-[16px] font-medium text-ink transition-[border-color,transform] duration-300 hover:translate-x-1 hover:border-blue-500"><span><%= o[0] %></span><span class="text-blue-500">→</span></button>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

    <div class="grid content-start gap-7 bg-navy-900 p-[clamp(28px,5vw,56px)] text-white">
      <div class="grid gap-2.5">
        <div class="flex items-baseline justify-between gap-4">
          <span class="font-mono text-xs tracking-[0.12em] text-mist-2">REVENUE HEALTH</span>
          <span class="font-display text-[44px] font-bold leading-none" data-rc-score>–</span>
        </div>
        <div class="h-[2px] w-14 bg-blue-300"></div>
      </div>
      <div class="grid gap-[26px]">
        <% rc.QUESTIONS.forEach(function(q) { %>
          <div class="grid gap-2.5" data-rc-meter="<%= q.key %>">
            <div class="flex justify-between gap-3">
              <span class="font-display text-[22px] font-bold"><%= q.area %></span>
              <span class="self-center font-mono text-xs uppercase tracking-[0.06em] text-white/50" data-rc-meter-label>Not answered</span>
            </div>
            <div class="h-2.5 overflow-hidden rounded-[10px] bg-white/10">
              <div class="h-full rounded-[10px] bg-white/30 transition-[width] duration-[900ms] ease-[var(--ease-kx)]" style="width: 8%;" data-rc-meter-bar></div>
            </div>
          </div>
        <% }) %>
      </div>
      <p class="text-sm text-mist-2">Updates as you answer.</p>
    </div>
  </div>
</section>
