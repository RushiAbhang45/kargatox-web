<%
// Shared admin nav, included near the top of <body> on every admin/*.ejs page.
// Needs `activeHref` (string, e.g. "/admin/team") and `currentUser` ({id, name,
// email, role}) from the route handler. Plain CSS/HTML — no JS-driven mobile drawer
// yet (unlike the legacy app's sidebar), so it's always visible; fine for now given
// admin usage is desktop-first.
const ADMIN_NAV = [
  { href: "/admin", label: "Dashboard" },
  { href: "/admin/enquiries", label: "Enquiries" },
  { href: "/admin/revenue-checks", label: "Revenue checks" },
  { href: "/admin/pages", label: "Pages" },
  { href: "/admin/services-faq", label: "Services & FAQ" },
  { href: "/admin/blog", label: "Blog & case studies" },
  { href: "/admin/team", label: "Team" },
  { href: "/admin/settings", label: "Settings" },
];
%>
<aside class="flex w-[240px] flex-none flex-col bg-navy-900 text-white">
  <div class="px-6 pb-2 pt-7">
    <a href="/admin" class="flex items-center gap-2.5">
      <span class="relative block h-[26px] w-[26px]">
        <span class="absolute left-0 top-0 h-[18px] w-[18px] rounded-[5px] bg-orange-500"></span>
        <span class="absolute bottom-0 right-0 h-[18px] w-[18px] rounded-[5px] bg-blue-500 mix-blend-screen"></span>
      </span>
      <span class="font-display text-[18px] font-bold tracking-[-0.02em]">Karga<span class="text-orange-400">tox</span></span>
    </a>
    <span class="mt-1 block font-mono text-[11px] tracking-[0.14em] text-mist-2">ADMIN</span>
  </div>

  <nav class="mt-4 flex-1 px-3">
    <% ADMIN_NAV.forEach(function(item) { %>
      <% const active = item.href === "/admin" ? activeHref === "/admin" : activeHref.startsWith(item.href); %>
      <a href="<%= item.href %>" class="mb-1 block rounded-[10px] px-3.5 py-2.5 text-[14px] font-medium transition-colors <%= active ? 'bg-white/10 text-white' : 'text-mist-2 hover:text-white' %>"><%= item.label %></a>
    <% }) %>
  </nav>

  <div class="border-t border-white/10 px-3 py-3">
    <a href="/" target="_blank" rel="noopener noreferrer" class="mb-1 block rounded-[10px] px-3.5 py-2.5 text-[14px] font-medium text-mist-2 transition-colors hover:text-white">View live site ↗</a>
  </div>

  <div class="border-t border-white/10 p-4">
    <div class="flex items-center gap-3">
      <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-orange-500 text-[13px] font-semibold text-white"><%= (currentUser.name || currentUser.email).charAt(0).toUpperCase() %></span>
      <div class="min-w-0">
        <p class="truncate text-[13px] font-semibold text-white"><%= currentUser.name || currentUser.email %></p>
        <p class="truncate font-mono text-[11px] tracking-[0.08em] text-mist-2"><%= currentUser.role %></p>
      </div>
    </div>
    <form method="post" action="/admin/logout" class="mt-3">
      <button type="submit" class="text-[13px] text-mist-2 underline-offset-2 hover:text-white hover:underline">Sign out</button>
    </form>
  </div>
</aside>
