<%
// Ported from legacy-nextjs-app/src/components/site-footer.tsx. `showCta` defaults to
// true, false only on Contact — matches today's prop. `ctaTopPadding` (2026-11-14 SEO
// content pass) defaults to false; About Us and Clients pass true since their last
// section ends flush with no bottom padding of its own, unlike every other page's. NAV_LINKS/
// SERVICE_PAGES come from app.locals (server.js) — see site-header.ejs for why.
// GEO_LATITUDE/GEO_LONGITUDE (also app.locals, from lib/seo-data.js) drive the "Our
// Location" embedded-map section added in the same pass. CALENDLY_URL (also app.locals)
// drives the "Book a call" button below — opens Calendly's popup widget via its documented
// JS API (Calendly.initPopupWidget), the script for which doc-head.ejs loads sitewide.
const _showCta = typeof showCta !== "undefined" ? showCta : true;
const _ctaTopPadding = typeof ctaTopPadding !== "undefined" && ctaTopPadding;
%>
<% if (_showCta) { %>
  <section class="bg-paper px-6 pb-[120px]<%= _ctaTopPadding ? ' pt-[80px]' : '' %>">
    <div class="mx-auto max-w-(--width-site) rounded-panel bg-orange-500 p-[clamp(40px,7vw,96px)] text-white">
      <div class="max-w-[640px]">
        <h2 class="font-display text-[clamp(30px,3.6vw,52px)] font-bold leading-[1.08] tracking-[-0.028em]">We move the only number that matters. Yours.</h2>
        <div class="mt-9 flex flex-wrap gap-3.5">
          <a href="/contact" class="rounded-pill bg-ink px-7 py-4 text-base font-semibold text-white transition-colors hover:bg-navy-700">Start an Inquiry →</a>
          <a href="/services" class="rounded-pill bg-white px-7 py-4 text-base font-semibold text-ink transition-colors hover:text-orange-500">See our services</a>
          <a href="<%= CALENDLY_URL %>" onclick="if (window.Calendly) { Calendly.initPopupWidget({ url: '<%= CALENDLY_URL %>' }); return false; }" target="_blank" rel="noopener" class="rounded-pill border border-white/40 px-7 py-4 text-base font-semibold text-white transition-colors hover:border-white">Book a call →</a>
        </div>
      </div>
    </div>
  </section>
<% } %>
<footer class="bg-ink px-6 pb-10 pt-16 text-mist-2 font-body">
  <%# Client request 2026-11-02: the old layout left a large empty band under the brand
      block and above the nav. Brand + contact details, page links, services and the map
      now share one row (stacking on small screens) instead of two half-empty rows. %>
  <div class="mx-auto grid max-w-(--width-site) grid-cols-1 gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,0.7fr)_minmax(0,1fr)_minmax(0,1.35fr)]">
    <div class="grid content-start gap-3.5">
      <a href="/" class="flex w-fit items-center gap-3" aria-label="Kargatox home">
        <picture>
          <source srcset="/images/kargatox-mark.webp" type="image/webp" />
          <img src="/images/kargatox-mark.png" alt="" width="52" height="52" loading="lazy" class="h-[52px] w-[52px]" />
        </picture>
        <span class="font-display text-[26px] font-bold tracking-[-0.02em] text-white">Karga<span class="text-orange-400">tox</span></span>
      </a>
      <p class="text-[15px] leading-[1.6]">Strategy, research and marketing for founders and leadership teams across India.</p>
      <address id="footer-location" class="kx-contact mt-2 grid gap-2 not-italic">
        <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-mist">Our Location</span>
        <span class="text-[14px] leading-[1.6] text-white">Kargatox, Coffice 24x7 (CO-102),<br/>Sai Vision, Pimple Saudagar,<br/>Pune, Maharashtra 411027, India</span>
        <a href="tel:+917887789471" class="text-[14px] text-mist transition-colors hover:text-orange-400">+91 78877 89471</a>
        <a href="mailto:<%= CONTACT_EMAIL %>" class="text-[14px] text-mist transition-colors hover:text-orange-400"><%= CONTACT_EMAIL %></a>
      </address>
    </div>
    <nav aria-label="Footer" class="grid content-start gap-2.5">
      <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-mist">Company</span>
      <% NAV_LINKS.forEach(function(l) { %>
        <a href="<%= l.href %>" class="text-[14px] text-mist transition-colors hover:text-orange-400"><%= l.label %></a>
      <% }) %>
    </nav>
    <div class="grid content-start gap-2.5">
      <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-mist">Services</span>
      <% SERVICE_PAGES.forEach(function(p) { %>
        <a href="/<%= p.slug %>" class="text-[14px] text-mist transition-colors hover:text-orange-400"><%= p.navTitle %></a>
      <% }) %>
    </div>
    <div class="grid content-start gap-3">
      <div class="h-[210px] overflow-hidden rounded-card border border-white/10">
        <iframe title="Kargatox office location on Google Maps" src="https://www.google.com/maps?q=<%= GEO_LATITUDE %>,<%= GEO_LONGITUDE %>&amp;z=16&amp;output=embed" class="h-full w-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>
      <a href="https://maps.app.goo.gl/NeJyGs6Z2QePoPEL6" target="_blank" rel="noopener" class="text-[14px] font-semibold text-orange-400">Get directions on Google Maps ↗</a>
    </div>
  </div>
  <div class="mx-auto mt-10 max-w-(--width-site) border-t border-white/10 pt-6 text-sm">© 2026 Kargatox. All rights reserved.</div>
</footer>
