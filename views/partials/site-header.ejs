<%
// Ported from legacy-nextjs-app/src/components/site-header.tsx. Needs `activePath`
// (string) from the caller. NAV_LINKS/SERVICE_PAGES/SERVICE_PAGE_GROUPS come from
// app.locals (server.js) — EJS templates rendered via res.render() don't have `require`
// in scope. Mobile drawer / Services dropdown are static markup here — the open/close
// interactivity (id="mobile-menu-toggle" / id="mobile-menu") is wired up in Phase 10.
%>
<header class="sticky top-0 z-50 border-b border-line bg-white">
  <div class="mx-auto flex max-w-(--width-site) items-center justify-between gap-6 px-6 py-4">
    <%- include('logo', { variant: 'light' }) %>
    <div class="hidden font-mono text-xs uppercase tracking-[0.14em] text-slate nav:block" data-scramble-reveal="Research · Marketing · Growth">Research · Marketing · Growth</div>
    <nav class="flex min-w-0 flex-none items-center justify-end gap-5">
      <div class="hidden min-w-0 flex-wrap justify-end gap-x-7 nav:flex">
        <% NAV_LINKS.forEach(function(l) { %>
          <% const active = activePath === l.href; %>
          <% const linkClass = "whitespace-nowrap border-b-2 pb-0.5 text-[15px] font-medium leading-6 transition-colors hover:text-ink " + (active ? "border-orange-500 text-ink" : "border-transparent text-slate"); %>
          <% if (l.href !== "/services") { %>
            <a href="<%= l.href %>" class="<%= linkClass %>"><%= l.label %></a>
          <% } else { %>
            <div class="group relative">
              <a href="<%= l.href %>" class="inline-flex items-center gap-1 <%= linkClass %>">
                <%= l.label %>
                <span aria-hidden="true" class="text-[9px] transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180">▾</span>
              </a>
              <div class="invisible absolute left-0 top-full z-20 w-[300px] pt-3 opacity-0 transition-[opacity,visibility] duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <div class="grid gap-5 rounded-card border border-line bg-white p-5 shadow-[0_24px_48px_-24px_rgba(15,23,42,0.28)]">
                  <% SERVICE_PAGE_GROUPS.forEach(function(group) { %>
                    <div class="grid gap-2">
                      <span class="font-mono text-[11px] uppercase tracking-[0.1em] text-slate"><%= group.heading %></span>
                      <% group.pages.forEach(function(p) { %>
                        <a href="/<%= p.slug %>" class="text-[14px] font-medium text-ink transition-colors hover:text-orange-500"><%= p.navTitle %></a>
                      <% }) %>
                    </div>
                  <% }) %>
                </div>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
      <a href="/contact" class="hidden flex-none whitespace-nowrap rounded-pill bg-ink px-4.5 py-2.5 text-[15px] font-semibold text-white transition-colors hover:bg-orange-500 nav:block">Start an Inquiry</a>
      <button type="button" id="mobile-menu-toggle" aria-label="Menu" aria-expanded="false" class="flex h-10 w-10 flex-none items-center justify-center rounded-[10px] border border-line text-lg text-ink nav:hidden">☰</button>
    </nav>
  </div>
  <div id="mobile-menu" class="hidden border-t border-line bg-white nav:hidden">
    <div class="mx-auto grid max-w-(--width-site) px-6 pb-6 pt-3">
      <% NAV_LINKS.forEach(function(l) { %>
        <% const active = activePath === l.href; %>
        <div class="border-b border-line">
          <a href="<%= l.href %>" class="block py-3.5 font-display text-2xl font-semibold transition-colors hover:text-orange-500 <%= active ? 'text-ink' : 'text-slate' %>"><%= l.label %></a>
          <% if (l.href === "/services") { %>
            <div class="grid gap-0.5 pb-4 pl-1">
              <% SERVICE_PAGES.forEach(function(p) { %>
                <a href="/<%= p.slug %>" class="py-1.5 text-[15px] text-slate transition-colors hover:text-orange-500"><%= p.navTitle %></a>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>
</header>
