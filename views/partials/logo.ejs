<%
// Ported from legacy-nextjs-app/src/components/logo.tsx. variant: "dark" (default,
// white-on-navy) | "light" (text-ink, used by the white-background site header).
const _variant = typeof variant !== "undefined" ? variant : "dark";
const _class = typeof className !== "undefined" ? className : "";
const textColor = _variant === "light" ? "text-ink" : "text-white";
%>
<a href="/" class="flex items-center gap-2.5 <%= textColor %> <%= _class %>">
  <span class="relative block h-[30px] w-[30px]">
    <span class="absolute left-0 top-0 h-5 w-5 rounded-[5px] bg-orange-500"></span>
    <span class="absolute bottom-0 right-0 h-5 w-5 rounded-[5px] bg-blue-500 mix-blend-screen"></span>
  </span>
  <span class="font-display text-[22px] font-bold tracking-[-0.02em] <%= textColor %>">Karga<span class="text-orange-400">tox</span></span>
</a>
