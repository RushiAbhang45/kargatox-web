{
  "name": "kargatox-web",
  "version": "0.1.0",
  "private": true,
  "description": "Kargatox marketing site + admin panel — plain Node/Express/EJS/vanilla JS (see CLAUDE.md).",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy --schema legacy-nextjs-app/prisma/schema.prisma",
    "build:css": "tailwindcss -i public/css/input.css -o public/css/styles.css --minify",
    "build:static": "node scripts/build-static.js",
    "build": "npm run build:css && npm run build:static"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@prisma/client": "^6.19.3",
    "@vercel/functions": "^3.11.3",
    "bcryptjs": "^3.0.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "dotenv": "^17.2.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3"
  }
}
