{
  "builds": [
    { "src": "legacy-nextjs-app/package.json", "use": "@vercel/next" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin(/.*)?", "dest": "/admin$1" },
    { "src": "/api/admin/(.*)", "dest": "/api/admin/$1" },
    { "src": "/api/auth/(.*)", "dest": "/api/auth/$1" },
    { "src": "/_next/(.*)", "dest": "/_next/$1" },
    { "src": "/css/(.*)", "dest": "/public/css/$1" },
    { "src": "/js/(.*)", "dest": "/public/js/$1" },
    { "src": "/images/(.*)", "dest": "/public/images/$1" },
    { "src": "/(favicon\\.ico|favicon-16x16\\.png|favicon-32x32\\.png|apple-touch-icon\\.png|android-chrome-192x192\\.png|android-chrome-512x512\\.png|site\\.webmanifest|robots\\.txt|sitemap\\.xml)", "dest": "/public/$1" },
    { "src": "/(.*)\\.html", "dest": "/public/$1.html" },
    { "src": "/$", "dest": "/public/index.html" },
    { "src": "/(.+)", "dest": "/public/$1.html" }
  ]
}
