# This is the frozen Next.js/TypeScript app, preserved as-is for reference/backup
# (see CLAUDE.md in the repo root for why). This .gitignore mirrors the root one,
# re-anchored here since root-anchored patterns like /node_modules don't reach into
# this nested directory.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma (SQLite local dev database; migrations/schema stay tracked)
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
