# Postgres (e.g. Neon). DATABASE_URL is the pooled (pgbouncer) connection the
# app uses at request time; DATABASE_URL_UNPOOLED is the direct connection
# Prisma needs to run migrations. Neon's dashboard gives you both.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"
# Generate with: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-secret"
# Optional: who gets seeded as OWNER by `npm run db:seed` (defaults to punedeveloper@mipl.co.in)
# SEED_OWNER_EMAIL="you@example.com"

# SMTP, used by src/lib/mailer.ts (enquiry auto-reply/notification/reply
# emails) and the Auth.js magic-link sender (src/auth.ts). For Gmail: enable
# 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD
# (a normal Gmail password won't work here). Omit all of these and the app
# falls back to logging emails to the console instead of sending them.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_FROM="Kargatox <you@gmail.com>"
# Who receives the "new enquiry" notification email
ADMIN_NOTIFY_EMAIL="you@gmail.com"
