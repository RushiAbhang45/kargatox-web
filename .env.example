# Postgres (e.g. Neon). DATABASE_URL is the pooled (pgbouncer) connection the
# app uses at request time; DATABASE_URL_UNPOOLED is the direct connection
# Prisma needs to run migrations. Neon's dashboard gives you both.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"
# Generate with: node -e "console.log(require('crypto').randomBytes(33).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-secret"
# Optional: who gets seeded as OWNER by `npm run db:seed` (defaults to punedeveloper@mipl.co.in)
# SEED_OWNER_EMAIL="you@example.com"
# Optional: sets that OWNER's password on seed. Sign-in is password-only (no
# magic link), so without this the seeded account can't sign in until a
# password is set some other way.
# SEED_OWNER_PASSWORD="replace-with-a-strong-password"

# SMTP, read by lib/mailer.js. Used by the admin Enquiries "Send reply" action and by every
# Contact form submission (team notification + the branded welcome email, lib/enquiry-mail.js).
# The welcome email must come from hello@kargatox.com, so SMTP_USER must be an account that is
# allowed to send as that address (e.g. the hello@ mailbox itself on Google Workspace / Zoho,
# or a Gmail account with hello@ added as a verified "Send mail as" alias). For Gmail/Workspace:
# enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD. Omit all of these and
# lib/mailer.js falls back to logging emails to the console instead of sending them.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="hello@kargatox.com"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_FROM="Kargatox <hello@kargatox.com>"
# Fallback recipient of the "new enquiry" notification when Settings → Notification email is empty
ADMIN_NOTIFY_EMAIL="you@gmail.com"

# Optional: AI write-up of the Contact form's website scan (lib/site-scan.js). Without it the
# scan still runs and lists its findings; only the Claude-written summary is skipped.
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: Cloudflare Turnstile (invisible CAPTCHA) on the Contact form. Both must be set to
# turn it on; get them at dash.cloudflare.com → Turnstile.
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
