// Postgres (Neon), per the README's recommended stack. `directUrl` is Neon's
// unpooled connection — Prisma needs a non-pgbouncer connection to run
// migrations, while `url` (pooled, via pgbouncer) is what the app uses at
// request time. `status`/`source`/`role` below stayed plain strings rather
// than native Prisma `enum`s even after the SQLite->Postgres move — no
// functional need to change them, so left as-is (validated at the API
// boundary with zod instead — see src/app/api/enquiries/route.ts and
// src/lib/roles.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Enquiry {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String?
  company        String?
  service        String
  details        String
  status         String   @default("NEW") // NEW | CONTACTED | PROPOSAL | WON | LOST
  ownerId        String?
  owner          User?    @relation(fields: [ownerId], references: [id])
  source         String // "Contact form" | "Revenue check"
  revenueCheckId String?
  revenueCheck   RevenueCheck? @relation(fields: [revenueCheckId], references: [id])
  createdAt      DateTime @default(now())
  messages       EnquiryMessage[]
}

// One row per completed Home-page quiz (src/components/home/revenue-check.tsx).
// `weakest` is "leads" | "sales" | "retention" — ties go to leads, then sales,
// then retention (see the component). `email`/`city` are unused for now: the
// quiz is anonymous and doesn't collect either.
model RevenueCheck {
  id        String   @id @default(cuid())
  leads     Int
  sales     Int
  retention Int
  weakest   String
  sessionId String
  email     String?
  city      String?
  createdAt DateTime @default(now())
  enquiries Enquiry[]
}

// A reply sent from the admin Enquiries detail panel. Incoming replies
// (Resend inbound / Gmail API webhook) aren't handled yet — see the README's
// Enquiries section — so every row here is outbound, from `sender`.
model EnquiryMessage {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?    @relation(fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// --- Auth.js (next-auth v5) + Prisma adapter — shape required by
// @auth/prisma-adapter (see node_modules/@auth/prisma-adapter/index.js):
// user/account/session/verificationToken delegates. src/auth.ts configures no
// providers at all (sign-in is password-only, handled outside Auth.js's own
// flow — see User.password below), so Account/VerificationToken exist only
// for adapter type-compatibility / future provider support.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("SALES") // OWNER | ADMIN | EDITOR | SALES — see src/lib/roles.ts
  // Bcrypt hash. Nullable at the schema level, but required in practice —
  // password is the only sign-in path (src/app/admin/login/actions.ts), so a
  // User row with no password can't sign in at all. Set via
  // src/lib/password-auth.ts's hashPassword() + a one-off Prisma script, or
  // via SEED_OWNER_PASSWORD for the row `npm run db:seed` creates.
  // Deliberately NOT wired into Auth.js's own Credentials provider: that
  // requires JWT sessions, which conflicts with the "database" session
  // strategy configured in src/auth.ts. Password sign-in instead creates a
  // real `Session` row directly, in the exact shape Auth.js's own adapter
  // flow would — see src/lib/password-auth.ts.
  password      String?
  createdAt     DateTime  @default(now())
  // Team invite flow (src/app/admin/(protected)/team/). invitedAt is set when
  // an OWNER/ADMIN sends an invite (the row is created with no password yet);
  // acceptedAt is set once the invitee sets a password via
  // src/app/admin/accept-invite/. Both null for users created by
  // `npm run db:seed` / `admin:set-password` directly, not through an invite.
  invitedAt     DateTime?
  acceptedAt    DateTime?
  // Updated on every successful password sign-in (src/lib/password-auth.ts's
  // createPasswordSession) — drives the Team page's "last active" column.
  lastActiveAt  DateTime?

  accounts        Account[]
  sessions        Session[]
  enquiries       Enquiry[]
  enquiryMessages EnquiryMessage[]
  posts           Post[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Step 7 (Pages): one row per public page ("home" | "services" | "how-we-work"
// | "faq" | "contact" — see src/lib/page-content-defaults.ts for the field
// keys per page). `published` is never null post-seed — it's what the public
// pages render. `draft` is null until someone edits a field in the admin
// Pages editor; Publish copies draft -> published (+ revalidatePath) and
// clears draft. The list dot is green when draft is null/equal to published,
// orange otherwise.
model PageContent {
  id        String   @id @default(cuid())
  page      String   @unique
  draft     Json?
  published Json
  updatedAt DateTime @updatedAt
}

// Step 7 (Services & FAQ): the editable sub-service rows under each top-level
// service card (src/app/(site)/services/data.ts's SERVICES — the dashboard
// panel data there, e.g. bars/KPIs, is NOT part of this admin section per the
// README spec, only item title/body/link). serviceKey is "research" |
// "marketing". No draft/publish here — a single "Save changes" button per the
// spec, so rows are the live content.
model SubService {
  id         String   @id @default(cuid())
  serviceKey String
  order      Int
  title      String
  body       String
  link       String?
  updatedAt  DateTime @updatedAt
}

// Step 7 (Services & FAQ): the FAQ tab's question/answer rows.
model FaqItem {
  id        String   @id @default(cuid())
  order     Int
  question  String
  answer    String
  updatedAt DateTime @updatedAt
}

// Step 7 (Blog & case studies). No cover image field — skipped for now (no
// object storage configured; see CLAUDE.md). type/status stay plain strings,
// same convention as Enquiry.status/source (src/lib/roles.ts).
model Post {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  type            String // "BLOG" | "CASE_STUDY"
  status          String    @default("DRAFT") // "DRAFT" | "PUBLISHED"
  excerpt         String?
  body            String // Tiptap JSON, stored serialized
  authorId        String?
  author          User?     @relation(fields: [authorId], references: [id])
  seoTitle        String?
  seoDescription  String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Step 8 (Settings). Singleton row (fixed id) — see src/lib/settings.ts's
// getSettings(). General fields back src/lib/email.ts (notificationEmail/
// alsoNotify replace the ADMIN_NOTIFY_EMAIL env var when set; autoReplyMessage/
// sendAutoReply replace the hardcoded auto-reply text). gaMeasurementId/
// gaEnabled drive the GA snippet in src/app/(site)/layout.tsx only — never the
// admin panel. SMTP intentionally has no fields here: it stays env-only
// (SMTP_* in .env/Vercel) so credentials never sit in the database; Settings
// only reads env to show connection status.
model Settings {
  id                String   @id @default("singleton")
  siteName          String   @default("Kargatox")
  notificationEmail String?
  alsoNotify        String?
  autoReplyMessage  String   @default("Hi {firstName},\n\nThank you for your requirement. Our team will contact you shortly.\n\n— Kargatox")
  sendAutoReply     Boolean  @default(true)
  gaMeasurementId   String?
  gaEnabled         Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}
